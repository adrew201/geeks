# Copy to .env and fill real values. Never commit .env.
# Placeholder values only. Get real ones per 01_Task/Claude-API-Setup.md.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Supabase direct connection string (port 5432, NOT the pooler) for local dev.
DATABASE_URL=postgresql://postgres:change-me@db.change-me.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID_PAID_GAMER=
PAYPAL_PLAN_ID_COACH=
PAYPAL_CURRENCY=USD

DONATION_FEE_BPS=500
DONATION_FEE_BPS_PAID_GAMER=250
BOUNTY_COMMISSION_BPS=1000

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=1500
DEBUG_AI=false

ADS_PER_SESSION_CAP=3
ADS_EVERY_N_CLIPS=5

FEATURE_ZAPIER_NOTIFICATIONS=false
FEATURE_SPONSOR_CAMPAIGNS=false
FEATURE_TRUST_SAFETY=false

ZAPIER_WEBHOOK_URL=

# Free Render tier has no worker service: run BullMQ workers inside the API process
RUN_WORKERS_IN_API=false

# Web app origin(s) allowed to call the API, comma-separated (default http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Password for every seeded demo account (npm run db:seed), min 8 chars. Share privately, never commit the value
SEED_PASSWORD=
