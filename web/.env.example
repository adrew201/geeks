# Copy to .env (never commit .env). Only VITE_-prefixed variables reach the browser,
# so nothing secret belongs here: no PayPal secret, JWT secret or Anthropic key.

# Base URL of the Play2Pro API (src/server.ts listens on PORT, default 3000).
# Leave it empty to call the same origin and let the dev proxy below forward requests.
VITE_API_URL=http://localhost:3000

# Dev only: where the Vite dev server forwards /auth, /api and /health (vite.config.ts).
# Use it with VITE_API_URL= (empty) to reach the Render API, whose CORS only allows the
# deployed site, e.g. VITE_PROXY_TARGET=https://geeks-azyy.onrender.com
VITE_PROXY_TARGET=

# PayPal sandbox client ID (public, safe in the browser). Ask Rabasa for the value.
VITE_PAYPAL_CLIENT_ID=

# "true" serves API calls from src/mocks, "false" calls VITE_API_URL.
# Leave unset to use mocks in dev and the real API in production builds.
VITE_USE_MOCKS=true

# Hybrid mode: with mocks on, these path prefixes still call the real API (comma-separated).
# Add each endpoint as the backend ships it, e.g. /auth,/api/v1/leaderboard
VITE_REAL_API=/auth
