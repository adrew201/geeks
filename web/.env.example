# Copy to .env (never commit .env). Only VITE_-prefixed variables reach the browser,
# so nothing secret belongs here: no PayPal secret, JWT secret or Anthropic key.

# Base URL of the Play2Pro API. src/server.ts defaults to port 4000 (README examples say 3000).
VITE_API_URL=http://localhost:4000

# PayPal sandbox client ID (public, safe in the browser). Ask Rabasa for the value.
VITE_PAYPAL_CLIENT_ID=

# "true" serves API calls from src/mocks, "false" calls VITE_API_URL.
# Leave unset to use mocks in dev and the real API in production builds.
VITE_USE_MOCKS=true
